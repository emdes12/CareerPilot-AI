# --- Core ---
DATABASE_URL=postgres://careerpilot@localhost:5433/careerpilot
PORT=4000
# Required in production (any long random string). Dev uses a random per-boot secret if unset.
JWT_SECRET=
OWNER_EMAIL=naijabayz@gmail.com
# Leave empty to auto-generate; the initial password is written to storage/INITIAL_PASSWORD.txt
OWNER_PASSWORD=
# Directory containing pg_dump (for nightly backups) if it is not on PATH
PG_BIN_DIR=C:/Program Files/PostgreSQL/15/bin

# --- Optional: Redis/BullMQ durable queue (otherwise in-process scheduler is used) ---
REDIS_URL=

# --- Optional: AI provider (all features work without it; AI only polishes wording under guardrails) ---
# AI_PROVIDER: openai | openrouter | gemini | anthropic
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_RESEARCH=
AI_MODEL_SCORING=
AI_MODEL_DOCUMENTS=
# Comma-separated models tried in order when the primary is overloaded (429/503) or unavailable
AI_FALLBACK_MODELS=
AI_MONTHLY_BUDGET_USD=10
# Per-agent model override, e.g. AGENT_MODEL_COVER_LETTER=gemini-3.8-flash
# AGENT_MODEL_<AGENT_NAME>=

# --- App ---
# Public URL of the web app (used for "Complete Your Application" links in notifications)
APP_BASE_URL=http://localhost:5173
CAREERPILOT_PORTFOLIO_URL=https://alawiyemuritala.xyz

# --- Resend (email). The key stays on the server only. Create a "Full access" key at resend.com/api-keys
# and verify alawiyemuritala.xyz under resend.com/domains before anything is sent. ---
RESEND_API_KEY=

# Identity 1: CareerPilot AI notifications — only ever sent to you
RESEND_FROM_EMAIL=notifications@alawiyemuritala.xyz
RESEND_FROM_NAME=CareerPilot AI
RESEND_REPLY_TO=
CAREERPILOT_NOTIFICATION_EMAIL=me@alawiyemuritala.xyz

# Identity 2: real job applications to employers — sent as you. Never falls back to identity 1.
JOB_APPLICATION_FROM_EMAIL=me@alawiyemuritala.xyz
JOB_APPLICATION_FROM_NAME=Alawiye Muritala Adeshina
JOB_APPLICATION_REPLY_TO=

# --- Optional: WhatsApp via Meta WhatsApp Business Cloud API (official) ---
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Approved message template with body params {{1}} role/company, {{2}} match %, {{3}} workspace link
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
